# Large local material kept alongside the repo but deliberately not in it.
# Library_V5_2024 is ~6 GB of MATLAB/Simulink working files (individual .mat
# and .fig files well past GitHub's 100 MB limit), and Documentation holds
# ~70 MB of PDFs and a video. Both are inputs to the work rather than part of
# the source; keeping them out is what lets this repository stay cloneable.
/Library_V5_2024/
/Documentation/

# Networks saved from the web UI at runtime -- per-user state, not source.
/networks_saved/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Built documentation (regenerated by python/tools/build_docs.py)
python/docs/sphinx/_build/

# Ad-hoc tooling (a headless browser used to check page layout)
node_modules/
package-lock.json
